# Copy to .env and fill in a real token. Never commit a real token.
# The server and every client (mush, rush, poller, rush executor, CLI)
# load .env from the current working directory when it exists; real
# environment variables take precedence over .env values.
# The server refuses to start without MUSINGS_TOKEN.
MUSINGS_TOKEN=change-me-to-a-long-random-token
MUSINGS_BASE_DIR=./data
MUSINGS_HOST=127.0.0.1
MUSINGS_PORT=8000
# MUSINGS_URL is read by the clients, not by the server: it tells mush,
# rush, the poller, and the rush executor where the service lives.
MUSINGS_URL=http://127.0.0.1:8000/api/v1
POLL_INTERVAL_SECONDS=10
JOB_TIMEOUT_SECONDS=300
MAX_OUTPUT_CHARS=100000
