# Copy to .env, fill in a real token, and chmod 600 it. Never commit a
# real token: whoever holds it holds the shell.
#
# Read by the server and by every client (mush, rush, the poller, the
# rush executor, the CLI) from the directory they are started in. A
# variable already exported in the shell wins over this file, and a
# missing file is silently ignored.

# The bearer token. Every protected route requires it, and the server
# refuses to start without it. Generate: openssl rand -hex 32
MUSINGS_TOKEN=change-me-to-a-long-random-token

# Where the service lives on this machine: the one source of truth for
# the address. Every local client connects to it, and the server listens
# on its port. Keep it loopback; a LAN usually cannot reach itself
# through its own public address.
#
# The scheme is the transport. https means the server terminates TLS
# itself with MUSINGS_TLS_CERT and MUSINGS_TLS_KEY and refuses to start
# without them. Listening beyond loopback over plain http is refused
# unless --insecure is passed, because the token would cross the network
# in the clear.
#
# Reaching the server from outside is a startup decision, not a setting:
#
#     musings-server                          listens on 127.0.0.1 only
#     musings-server --public                 listens on every interface,
#                                             for a port forward or LAN
#     musings-server --public --with-poller   as above, and commands run
#                                             on this host, as this user
#     musings-server --public --insecure      every interface, plain http
#
# A remote client uses whatever address the network in front of the
# server presents (a public IP, a tunnel, a hostname) with this same
# token. That address is a fact about the network, not a setting here.
MUSINGS_URL=https://127.0.0.1:8000/api/v1

# Where /save writes files and where the EOT marker lands. Files are
# confined here; commands run by a poller are not confined at all.
MUSINGS_BASE_DIR=./data

# TLS, server side. Mint a private CA and a server certificate with
# scripts/pki_make.sh (ca, then server --san IP:<lan>,IP:<public>); the
# server certificate always names localhost and 127.0.0.1 so an embedded
# poller can reach it. MUSINGS_TLS_CLIENT_CA is optional and turns on
# mutual TLS: every connection must present a certificate signed by that
# authority, so the token alone no longer opens a shell.
MUSINGS_TLS_CERT=/path/to/pki/server.pem
MUSINGS_TLS_KEY=/path/to/pki/server.key
MUSINGS_TLS_CLIENT_CA=/path/to/pki/ca.pem

# TLS, client side. MUSINGS_CA_CERT pins the server certificate to your
# CA (unset means the system trust store; verification is never off).
# The client certificate pair is needed only when the server sets
# MUSINGS_TLS_CLIENT_CA; mint one with scripts/pki_make.sh client --name X.
# The poller embedded by --with-poller inherits these three.
MUSINGS_CA_CERT=/path/to/pki/ca.pem
MUSINGS_CLIENT_CERT=/path/to/pki/clients/thishost.pem
MUSINGS_CLIENT_KEY=/path/to/pki/clients/thishost.key

# Poller tuning. POLL_WAIT_SECONDS is how long the claim long-poll parks
# on the server before returning empty and polling again (the server
# caps it at 30). POLL_INTERVAL_SECONDS is the error backoff.
POLL_WAIT_SECONDS=20
POLL_INTERVAL_SECONDS=10

# Execution limits applied by the poller to every job.
JOB_TIMEOUT_SECONDS=300
MAX_OUTPUT_CHARS=100000
