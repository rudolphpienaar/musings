# Copy to .env and fill in a real token. Never commit a real token.
# The server and every client (mush, rush, poller, rush executor, CLI)
# load .env from the current working directory when it exists; real
# environment variables take precedence over .env values.
# The server refuses to start without MUSINGS_TOKEN.
MUSINGS_TOKEN=change-me-to-a-long-random-token
MUSINGS_BASE_DIR=./data
MUSINGS_HOST=127.0.0.1
MUSINGS_PORT=8000
# MUSINGS_URL tells mush, rush, the poller, and the rush executor
# where the service lives; the server derives its bind host and port
# from it when MUSINGS_HOST / MUSINGS_PORT are unset.
MUSINGS_URL=http://127.0.0.1:8000/api/v1
# POLL_WAIT_SECONDS is how long the poller's claim long-poll parks on
# the server before returning empty and polling again; the server caps
# it at 30. POLL_INTERVAL_SECONDS is the poller's error backoff.
POLL_WAIT_SECONDS=20
POLL_INTERVAL_SECONDS=10
JOB_TIMEOUT_SECONDS=300
MAX_OUTPUT_CHARS=100000
